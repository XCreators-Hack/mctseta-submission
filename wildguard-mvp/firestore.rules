rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function role() {
      return request.auth.token.role;
    }
    function isAdmin() {
      return isSignedIn() && role() == "admin";
    }
    function isRole(r) {
      return isSignedIn() && role() == r;
    }
    function sameCompany(companyId) {
      return isSignedIn() && request.auth.token.companyId == companyId;
    }

    // ---- users ----
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // ---- companies ----
    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- wildlifeOrgs ----
    match /wildlifeOrgs/{orgId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- drivers ----
    match /drivers/{driverId} {
      allow read: if isSignedIn() &&
        (isAdmin() || isRole("wildlife") || sameCompany(resource.data.companyId));
      allow write: if isAdmin() ||
        (isRole("logistics") && sameCompany(resource.data.companyId));
    }

    // ---- trucks (private per logistics company, visible read-only to wildlife/admin) ----
    match /trucks/{truckId} {
      allow read: if isSignedIn() &&
        (isAdmin() || isRole("driver") || isRole("wildlife") || sameCompany(resource.data.companyId));
      allow write: if isAdmin() ||
        (isRole("logistics") && sameCompany(resource.data.companyId));
    }

    // ---- devices ----
    match /devices/{deviceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- corridors ----
    match /corridors/{corridorId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- zones ----
    match /zones/{zoneId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isRole("wildlife");
    }

    // ---- hazards ----
    match /hazards/{hazardId} {
      allow read: if isSignedIn();
      // Acknowledge/clear handled via server API routes with Admin SDK
      // (bypasses rules); direct client writes are blocked.
      allow write: if false;
    }

    // ---- events (append-only log) ----
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if false; // only server (Admin SDK) may write events
      allow update, delete: if false;
    }

    // ---- alerts ----
    match /alerts/{alertId} {
      allow read: if isSignedIn();
      allow write: if false; // server-managed
    }

    // ---- sensorReadings ----
    match /sensorReadings/{readingId} {
      allow read: if isSignedIn();
      allow write: if false; // server-managed
    }

    // ---- auditLogs ----
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // server-managed
    }
  }
}
